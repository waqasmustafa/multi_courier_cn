<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_courier_generate_cn_wizard_form" model="ir.ui.view">
        <field name="name">courier.generate.cn.wizard.form</field>
        <field name="model">courier.generate.cn.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate CN">
                <field name="sale_order_id" invisible="1"/>
                <group>
                    <field name="carrier_id" readonly="state == 'booked'"/>
                    <field name="fragile" readonly="state == 'booked'"/>
                    <field name="remarks" readonly="state == 'booked'"/>
                    <field name="tracking_number" invisible="state != 'booked'"/>
                </group>
                <footer>
                    <button name="action_book" type="object" string="Book"
                            class="btn-primary" invisible="state == 'booked'"/>
                    <button name="action_print" type="object" string="Print"
                            class="btn-primary" invisible="state != 'booked'"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
