<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_courier_slip" model="report.paperformat">
        <field name="name">Courier Slip</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="margin_top">2</field>
        <field name="margin_bottom">2</field>
        <field name="margin_left">3</field>
        <field name="margin_right">3</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <template id="report_courier_slip_document">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="o">
                <t t-set="order" t-value="o.sale_order_id"/>
                <t t-set="partner" t-value="order.partner_shipping_id or order.partner_id"/>
                <t t-set="company" t-value="o.company_id"/>
                <t t-set="product_lines" t-value="order.order_line.filtered(lambda l: l.product_id and not l.display_type)"/>
                <t t-set="live_items" t-value="int(sum(product_lines.mapped('product_uom_qty')) or 1)"/>
                <t t-set="live_weight" t-value="sum((l.product_id.weight or 0.0) * l.product_uom_qty for l in product_lines) or 1.0"/>
                <div class="page" style="font-size: 12px; margin: 0; padding: 0;">
                    <table style="width: 100%; border-collapse: collapse; border: 1px solid #000; margin: 0;">
                        <tr>
                            <td colspan="2" style="border: 1px solid #000; padding: 6px; text-align: center; vertical-align: middle;">
                                <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height: 45px; max-width: 100%;"/>
                                <div style="font-weight: bold; font-size: 16px;" t-esc="company.name"/>
                            </td>
                            <td colspan="4" style="border: 1px solid #000; padding: 6px; text-align: center; vertical-align: middle;">
                                <img t-if="o.tracking_number"
                                     t-att-src="'/report/barcode/Code128/%s?width=350&amp;height=60&amp;humanreadable=1' % o.tracking_number"
                                     style="max-width: 100%; max-height: 60px;"/>
                            </td>
                            <td colspan="2" style="border: 1px solid #000; padding: 0;">
                                <table style="width: 100%; border-collapse: collapse; height: 100%;">
                                    <tr>
                                        <td style="padding: 4px; border-bottom: 1px solid #000; width: 50%;">Date</td>
                                        <td style="padding: 4px; border-bottom: 1px solid #000; border-left: 1px solid #000;" t-esc="o.create_date and o.create_date.strftime('%d-%m-%y')"/>
                                    </tr>
                                    <tr>
                                        <td style="padding: 4px;">Destination</td>
                                        <td style="padding: 4px; border-left: 1px solid #000;" t-esc="partner.city"/>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <tr>
                            <td style="border: 1px solid #000; padding: 6px; font-weight: bold; width: 12.5%;">Shipper</td>
                            <td style="border: 1px solid #000; padding: 6px; width: 37.5%;" t-esc="company.name"/>
                            <td style="border: 1px solid #000; padding: 6px; font-weight: bold; width: 12.5%;">Consignee</td>
                            <td colspan="3" style="border: 1px solid #000; padding: 6px; width: 37.5%;" t-esc="partner.name"/>
                        </tr>
                        <tr>
                            <td colspan="2" style="border: 1px solid #000; padding: 6px;">
                                <span t-esc="', '.join(filter(None, [company.street, company.city]))"/><br/>
                                <span t-esc="company.phone"/>
                                <span t-if="company.email"> / <t t-esc="company.email"/></span>
                            </td>
                            <td colspan="4" style="border: 1px solid #000; padding: 6px;">
                                <span t-esc="', '.join(filter(None, [partner.street, partner.street2, partner.city]))"/><br/>
                                <span t-esc="partner.phone or partner.mobile"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="border: 1px solid #000; padding: 6px; font-weight: bold;">
                                <em># of Items</em>
                            </td>
                            <td style="border: 1px solid #000; padding: 6px;" t-esc="live_items"/>
                            <td style="border: 1px solid #000; padding: 6px; font-weight: bold;">Weight</td>
                            <td style="border: 1px solid #000; padding: 6px;" t-esc="live_weight"/>
                            <td style="border: 1px solid #000; padding: 6px; font-weight: bold;">Fragile</td>
                            <td style="border: 1px solid #000; padding: 6px;">YES</td>
                            <td style="border: 1px solid #000; padding: 6px; font-weight: bold;">COD Amount</td>
                            <td style="border: 1px solid #000; padding: 6px;">
                                <span t-esc="order.currency_id.symbol"/> <span t-esc="'%.0f' % order.amount_total"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="border: 1px solid #000; padding: 6px; font-weight: bold;">ORDER ID</td>
                            <td style="border: 1px solid #000; padding: 6px;" t-esc="order.name"/>
                            <td colspan="2" style="border: 1px solid #000; padding: 6px; font-weight: bold;">Remarks</td>
                            <td colspan="4" style="border: 1px solid #000; padding: 6px;" t-esc="o.carrier_id.name"/>
                        </tr>
                        <tr>
                            <td colspan="2" style="border: 1px solid #000; padding: 6px; font-weight: bold;">Product Detail</td>
                            <td colspan="6" style="border: 1px solid #000; padding: 6px;">
                                <t t-esc="', '.join('%s X %s' % (line.product_id.name, int(line.product_uom_qty)) for line in product_lines)"/>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="8" style="border: 1px solid #000; padding: 8px; text-align: center; font-weight: bold;">
                                Please do not open the parcel before payment.
                            </td>
                        </tr>
                    </table>
                </div>
            </t>
        </t>
    </template>

    <record id="action_report_courier_slip" model="ir.actions.report">
        <field name="name">Courier Slip</field>
        <field name="model">courier.shipment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">multi_courier_cn.report_courier_slip_document</field>
        <field name="report_file">multi_courier_cn.report_courier_slip_document</field>
        <field name="print_report_name">'CN - %s' % (object.tracking_number or object.name)</field>
        <field name="paperformat_id" ref="paperformat_courier_slip"/>
        <field name="binding_model_id" ref="model_courier_shipment"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
