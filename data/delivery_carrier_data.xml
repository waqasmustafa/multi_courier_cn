<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_product_delivery_courier" model="product.product">
        <field name="name">Courier Delivery Charges</field>
        <field name="type">service</field>
        <field name="invoice_policy">order</field>
        <field name="list_price">0.0</field>
        <field name="sale_ok" eval="False"/>
        <field name="purchase_ok" eval="False"/>
        <field name="base_unit_count">1</field>
    </record>

    <record id="delivery_carrier_postex" model="delivery.carrier">
        <field name="name">PostEx</field>
        <field name="delivery_type">postex</field>
        <field name="product_id" ref="product_product_delivery_courier"/>
    </record>

    <record id="delivery_carrier_tcs" model="delivery.carrier">
        <field name="name">TCS</field>
        <field name="delivery_type">tcs</field>
        <field name="product_id" ref="product_product_delivery_courier"/>
    </record>

    <record id="delivery_carrier_zoomcod" model="delivery.carrier">
        <field name="name">ZoomCOD</field>
        <field name="delivery_type">zoomcod</field>
        <field name="product_id" ref="product_product_delivery_courier"/>
    </record>
</odoo>
