<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delivery_carrier_form_courier" model="ir.ui.view">
        <field name="name">delivery.carrier.form.courier.inherit</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">
            <field name="delivery_type" position="after">
                <group string="PostEx Configuration" invisible="delivery_type != 'postex'">
                    <field name="postex_token" password="True"/>
                    <field name="postex_pickup_address_code"/>
                    <field name="postex_api_url"/>
                </group>
                <group string="TCS Configuration" invisible="delivery_type != 'tcs'">
                    <field name="tcs_bearer_token" password="True"/>
                    <field name="tcs_access_token" password="True"/>
                    <field name="tcs_cost_center"/>
                    <field name="tcs_client_id"/>
                    <field name="tcs_account_number"/>
                    <field name="tcs_shipper_city_code"/>
                    <field name="tcs_service_code"/>
                    <field name="tcs_api_url"/>
                </group>
                <group string="Zoom Configuration" invisible="delivery_type != 'zoomcod'">
                    <field name="zoom_auth_key" password="True"/>
                    <field name="zoom_client_code"/>
                    <field name="zoom_profile_id"/>
                    <field name="zoom_product"/>
                    <field name="zoom_service_type"/>
                    <field name="zoom_api_url"/>
                </group>
                <group string="Daewoo Configuration" invisible="delivery_type != 'daewoo'">
                    <field name="daewoo_api_key" password="True"/>
                    <field name="daewoo_api_user"/>
                    <field name="daewoo_api_password" password="True"/>
                    <field name="daewoo_source_terminal_id"/>
                    <field name="daewoo_api_url"/>
                </group>
                <group string="Leopard Configuration" invisible="delivery_type != 'leopard'">
                    <field name="leopard_book_api_key" password="True"/>
                    <field name="leopard_book_api_password" password="True"/>
                    <field name="leopard_cancel_api_key" password="True"/>
                    <field name="leopard_cancel_api_password" password="True"/>
                    <field name="leopard_shipment_id"/>
                    <field name="leopard_api_url"/>
                </group>
                <group string="Manual Courier" invisible="delivery_type != 'manual'">
                    <div colspan="2">
                        No API is called. When Generate CN is used, the tracking number is created
                        locally as the first 3 letters of this Delivery Method's name (uppercase)
                        followed by the order's ID - e.g. "Self Pickup" produces SEL123.
                    </div>
                </group>
                <button name="action_test_connection" type="object" string="Test Connection"
                        class="btn-secondary"
                        invisible="delivery_type not in ('postex', 'tcs', 'zoomcod', 'daewoo', 'leopard', 'manual')"/>
            </field>
        </field>
    </record>
</odoo>
